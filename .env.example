NODE_ENV=development
PORT=3000

# Use DATABASE_URL no Render/Supabase/Neon. Se preferir, mantenha o modo antigo por DB_HOST/DB_USER.
DATABASE_URL=postgresql://usuario:senha@localhost:5432/executiva_frota
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Alternativa ao DATABASE_URL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=executiva_frota
DB_USER=postgres
DB_PASSWORD=change-me

# Gere um segredo forte com pelo menos 32 caracteres antes de subir para producao.
JWT_SECRET=troque-por-um-segredo-grande-com-32-caracteres
JWT_EXPIRES_IN=12h
JWT_ISSUER=executiva-frota
JWT_AUDIENCE=executiva-frota-web
MIN_PASSWORD_LENGTH=8
AUTH_CHECK_USER_STATUS=true

# Separar por virgula quando tiver frontend em outro dominio.
CORS_ORIGINS=http://localhost:3000
JSON_LIMIT=1mb
RATE_LIMIT_MAX=900
AUTH_RATE_LIMIT_MAX=30

# Mantenha false enquanto voce nao quiser que o backend crie/altere tabelas automaticamente.
SCHEMA_SYNC_ENABLED=false

# Regras de seguranca para payloads e anexos enviados como metadados.
MAX_JSON_DEPTH=8
MAX_ARRAY_LENGTH=1000
MAX_STRING_LENGTH=5000
MAX_ATTACHMENTS=5
MAX_ATTACHMENT_BYTES=10485760
